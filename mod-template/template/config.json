{
    "match": "https://www.template.com/",
    "inject": [
        {
            "path": "dist/index.js",
            "type": "script"
        },
        {
            "path": "dist/index.css",
            "type": "style"
        }
    ],
    "options": [
        {
            "key": "enabled",
            "type": "toggle",
            "label": "Enable feature",
            "default": true
        },
        {
            "key": "greeting",
            "type": "text",
            "label": "Greeting text",
            "default": "hello"
        },
        {
            "key": "theme",
            "type": "dropdown",
            "label": "Theme",
            "default": "light",
            "choices": [
                { "value": "light", "label": "Light" },
                { "value": "dark", "label": "Dark" }
            ]
        },
        {
            "key": "sections",
            "type": "checklist",
            "label": "Visible sections",
            "default": [],
            "dynamic": true
        },
        {
            "key": "status",
            "type": "label",
            "label": "Status",
            "default": "idle"
        },
        {
            "key": "refresh",
            "type": "button",
            "label": "Refresh now"
        }
    ]
}
